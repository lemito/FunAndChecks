@page "/admin/grading"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>@Loc["Grading_PageTitle"]</PageTitle>

<div class="fc-page-heading"><div><div class="fc-eyebrow">@Loc["AdminNav_Grading"]</div><MudText Typo="Typo.h4">@Loc["Grading_Title"]</MudText></div>
    <AuthorizeView Roles="@Roles.SuperAdmin"><Authorized>
        <MudButton Variant="Variant.Outlined" Href="/admin/student-accounts" StartIcon="@Icons.Material.Outlined.ManageAccounts">
            @Loc["Grading_ManageAccounts"]
        </MudButton>
    </Authorized></AuthorizeView>
</div>

<div class="fc-panel fc-toolbar fc-grading-filters">
    <MudSelect T="int?" @bind-Value="_subjectId" @bind-Value:after="OnSubjectChangedAsync" Label="@Loc["Common_Subject"]" Variant="Variant.Outlined"
               Placeholder="@Loc["Grading_SelectSubject"]" Margin="Margin.Dense">
        @foreach (var s in _subjects) { <MudSelectItem T="int?" Value="@s.Id">@s.Name</MudSelectItem> }
    </MudSelect>
    @if (StudentGroups.Count > 1)
    {
        <MudSelect T="int?" @bind-Value="_groupFilter" Label="@Loc["QueueDetails_Groups"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            @foreach (var (id, name) in StudentGroups) { <MudSelectItem T="int?" Value="@id">@name</MudSelectItem> }
        </MudSelect>
    }
    <MudTextField @bind-Value="_query" Label="@Loc["Grading_SearchLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" />
</div>

@if (_subjectId is null)
{
    <div class="fc-panel fc-core-empty"><MudIcon Icon="@Icons.Material.Outlined.PersonSearch" Size="Size.Large" /><MudText Class="fc-muted">@Loc["Grading_SelectSubjectHint"]</MudText></div>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-3" />
}
else if (Visible is { Count: > 0 } visible)
{
    <section class="fc-panel fc-grading-list">
        <div class="fc-core-panel-heading"><MudText Typo="Typo.h6">@Loc["AdminNav_Grading"]</MudText><MudText Typo="Typo.caption" Class="fc-muted">@visible.Count</MudText></div>
        @foreach (var student in visible)
        {
            <article class="fc-grading-row" @key="student.Id">
                <div class="fc-grading-identity">
                    <UserChip UserId="student.Id" Name="@($"{student.LastName} {student.FirstName}")" NameClass="fc-student-name" NameStyle="@QueueStyles.NameStyle(student.Color)" Compact="true"
                              Subtitle="@(student.GroupId is int g ? _groupNames.GetValueOrDefault(g) : null)" />
                    <MudText Typo="Typo.caption" Class="fc-muted">@ProgressText(student) · @student.Email</MudText>
                    @if (IsGroupRestricted(student))
                    {
                        <MudText Typo="Typo.caption" Class="fc-semantic-warning">@Loc["Common_GradingRestricted"]</MudText>
                    }
                </div>
                <div class="fc-grading-actions">
                    <AuthorizeView Roles="@Roles.SuperAdmin">
                        <Authorized><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@((e) => EditAsync(student))" aria-label="@Loc["StudentGrading_EditProfileTitle"]" /></Authorized>
                    </AuthorizeView>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@IsGroupRestricted(student)"
                               OnClick="@(() => OpenAsync(student))">@Loc["QueueDetails_Review"]</MudButton>
                </div>
            </article>
        }
    </section>
}
else
{
    <div class="fc-panel fc-core-empty"><MudText Class="fc-muted">@Loc["Grading_NoStudents"]</MudText></div>
}
