@page "/privacy-policy"
@layout AuthLayout
@using Frontend.Shared.Community
@inject IStringLocalizer<AppStrings> Loc
@inject FeatureFlagsService Flags
@inject NavigationManager NavigationManager

<PageTitle>@Loc["PrivacyPolicy_PageTitle"]</PageTitle>

@if (!Flags.PrivacyPolicy)
{
    <section class="fc-legal-card">
        <div class="fc-legal-head">
            <MudText Typo="Typo.h5">@Loc["PrivacyPolicy_Unavailable"]</MudText>
        </div>
        <div class="fc-legal-body">
            <div class="fc-legal-content">
                <p>@Loc["PrivacyPolicy_UnavailableHint"]</p>
            </div>
            <div class="fc-legal-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/register">
                    @Loc["PrivacyPolicy_BackToRegister"]
                </MudButton>
            </div>
        </div>
    </section>
}
else
{
    <section class="fc-legal-card">
        <div class="fc-legal-head">
            <MudText Typo="Typo.h5">@Loc["PrivacyPolicy_Title"]</MudText>
        </div>
        <div class="fc-legal-body">
            <div class="fc-legal-content">
                @((MarkupString)ForumMarkdown.ToHtml(Loc["PrivacyPolicy_Text"], "/student"))
            </div>
            <div class="fc-legal-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/register">
                    @Loc["PrivacyPolicy_BackToRegister"]
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/login">
                    @Loc["Common_BackToLogin"]
                </MudButton>
            </div>
        </div>
    </section>
}