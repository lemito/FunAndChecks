@namespace Frontend.Shared.Profiles
@using System.Globalization
@implements IDisposable
@inject ProfileApi Api
@inject MeApi Me
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ResultsNavigationState ResultsNavigation
@inject UnsavedChangesTracker Dirty

<PageTitle>@(_profile?.FullName ?? ProfileText.T("Личный кабинет", "Profile"))</PageTitle>
<div class="fc-page-heading"><div>
    @if (!_mine) { <a class="fc-profile-back" href="@ReturnPath">← @ProfileText.T("К таблице результатов", "Back to results")</a> }
    <MudText Typo="Typo.h4">@(_mine ? ProfileText.T("Мой кабинет", "My profile") : ProfileText.T("Профиль пользователя", "User profile"))</MudText>
    <MudText Class="fc-muted">@ProfileText.T("Немного о себе и о том, что уже получилось.", "A little about you and what you have achieved.")</MudText>
</div>@if (_admin && _profile is not null) { <MudButton OnClick="() => _grant = true" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.EmojiEvents">@ProfileText.T("Выдать достижение", "Grant achievement")</MudButton> }</div>
@if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_error <MudButton OnClick="LoadAsync">@ProfileText.T("Повторить", "Retry")</MudButton></MudAlert> }
@if (_loading) { <div class="fc-loading"><MudProgressCircular Indeterminate="true" /></div> }
else if (_profile is not null)
{
    <section class="fc-panel fc-profile-hero">
        <ProfileMedia Media="_profile.Avatar" Alt="@_profile.FullName" Fallback="@ProfileText.Initials(_profile.FullName)" Class="fc-profile-avatar" />
        <div class="fc-profile-identity"><h1>@_profile.FullName</h1><div class="fc-profile-tags"><span>@(_profile.IsAdmin ? ProfileText.T("Преподаватель", "Teacher") : ProfileText.T("Студент", "Student"))</span>@if (_profile.GroupName is not null) { <span>@_profile.GroupName</span> }</div></div>
        @if (_mine) { <MudButton OnClick="Edit" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit">@ProfileText.T("Редактировать", "Edit profile")</MudButton> }
    </section>
    <div class="fc-profile-columns">
        <div>
            <section class="fc-panel fc-profile-section"><div class="fc-profile-section-heading"><h2>@ProfileText.T("Закреплённые достижения", "Pinned achievements")</h2><span>@_profile.Awards.Count(x => x.PinPosition.HasValue) / 3</span></div>
                @if (!_profile.Awards.Any(x => x.PinPosition.HasValue)) { <p class="fc-profile-empty">@(_mine ? ProfileText.T("Откройте полученную награду, чтобы закрепить её здесь.", "Open an earned achievement to pin it here.") : ProfileText.T("Пока нет закреплённых достижений.", "No pinned achievements yet."))</p> }
                else { <div class="fc-profile-badge-grid">@foreach (var award in _profile.Awards.Where(x => x.PinPosition.HasValue).OrderBy(x => x.PinPosition)) { <AchievementCard @key="award.Id" Name="@award.Name" Description="@award.Description" Image="award.Image" Pinned="true" Meta="@Date(award.GrantedAtUtc)" Click="() => _award = award" /> }</div> }
            </section>
            <section class="fc-panel fc-profile-section"><div class="fc-profile-section-heading"><h2>@ProfileText.T("Все достижения", "All achievements")</h2><span>@_profile.Awards.Count</span></div>
                @if (_profile.Awards.Count == 0) { <p class="fc-profile-empty">@ProfileText.T("Первые достижения ещё впереди.", "Your first achievements are still ahead.")</p> }
                else { <div class="fc-profile-badge-grid">@foreach (var award in _profile.Awards.OrderByDescending(x => x.GrantedAtUtc)) { <AchievementCard @key="award.Id" Name="@award.Name" Description="@award.Description" Image="award.Image" Meta="@Date(award.GrantedAtUtc)" Click="() => _award = award" /> }</div> }
            </section>
        </div>
        <div>
            <section class="fc-panel fc-profile-section"><h2>@ProfileText.T("О себе", "About me")</h2><p class="fc-profile-bio">@(string.IsNullOrWhiteSpace(_profile.AboutMe) ? ProfileText.T("Пользователь пока не добавил описание.", "This user has not added a description yet.") : _profile.AboutMe)</p>
                <div class="fc-profile-links">@if (_profile.GitHubUrl is not null) { <a href="@_profile.GitHubUrl" target="_blank" rel="noopener noreferrer">↗ GitHub</a> }@if (_profile.PortfolioUrl is not null) { <a href="@_profile.PortfolioUrl" target="_blank" rel="noopener noreferrer">↗ @ProfileText.T("Портфолио", "Portfolio")</a> }</div>
            </section>
            @if (_mine) { <section class="fc-panel fc-profile-section"><h2>@ProfileText.T("Продолжить работу", "Continue learning")</h2><div class="fc-profile-quick-links"><a href="@BasePath">@ProfileText.T("Результаты", "Results") →</a><a href="@(BasePath + "/queues")">@ProfileText.T("Очереди", "Queues") →</a><a href="@(BasePath + "/achievements")">@ProfileText.T("Каталог достижений", "Achievement catalog") →</a></div></section> }
        </div>
    </div>
}
@if (_edit && !_avatarEditor)
{
    <ProfileDialog Title="@ProfileText.T("Редактировать профиль", "Edit profile")" Close="CancelEdit" Busy="@_busy">
        <ChildContent><div class="fc-profile-edit-avatar"><ProfileMedia Media="_profile?.Avatar" Alt="@(_profile?.FullName ?? "")" Fallback="@ProfileText.Initials(_profile?.FullName ?? "")" Class="fc-profile-avatar" /><div><MudButton OnClick="() => _avatarEditor = true" Variant="Variant.Outlined">@ProfileText.T("Изменить аватар", "Change avatar")</MudButton>@if (_profile?.Avatar is not null) { <MudButton OnClick="RemoveAvatarAsync" Disabled="@_busy" Color="Color.Error">@ProfileText.T("Удалить", "Remove")</MudButton> }</div></div>
            @if (_editError is not null) { <MudAlert Severity="Severity.Error">@_editError</MudAlert> }
            <MudTextField T="string" @bind-Value="_about" Immediate="true" Label="@ProfileText.T("О себе", "About me")" Lines="5" MaxLength="2000" Variant="Variant.Outlined" Class="mt-4" />
            <MudTextField T="string" @bind-Value="_github" Immediate="true" Label="GitHub" MaxLength="500" Variant="Variant.Outlined" Class="mt-3" />
            <MudTextField T="string" @bind-Value="_portfolio" Immediate="true" Label="@ProfileText.T("Портфолио", "Portfolio")" MaxLength="500" Variant="Variant.Outlined" Class="mt-3" />
            <p class="fc-profile-hint">@ProfileText.T("Описание и ссылки видны другим пользователям после входа. ФИО и группу меняет администратор.", "Your description and links are visible to signed-in users. Administrators manage your name and group.")</p>
        </ChildContent><Actions><MudButton OnClick="CancelEdit" Disabled="@_busy">@ProfileText.T("Отмена", "Cancel")</MudButton><MudButton OnClick="SaveProfileAsync" Disabled="@_busy" Color="Color.Primary" Variant="Variant.Filled">@ProfileText.T("Сохранить", "Save")</MudButton></Actions>
    </ProfileDialog>
}
@if (_avatarEditor) { <MediaEditor Save="SaveAvatarAsync" Close="() => _avatarEditor = false" /> }
@if (_award is not null) { <AchievementDetail AchievementId="_award.AchievementId" Award="_award" Mine="_mine" IsAdmin="_admin" BasePath="@BasePath" Pin="TogglePinAsync" Changed="RefreshAwardAsync" Close="() => _award = null" /> }
@if (_grant && _profile is not null) { <GrantAchievementDialog Recipient="@(new AchievementUserDto(_profile.UserId, _profile.FullName, _profile.GroupName, _profile.IsAdmin))" Changed="GrantDoneAsync" Close="() => _grant = false" /> }

@code {
    [Parameter] public Guid? UserId { get; set; }
    [Parameter] public bool IsAdminLayout { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }
    private string BasePath => IsAdminLayout ? "/admin" : "/student";
    private string ReturnPath => ReturnUrl is { Length: > 0 } value && value.StartsWith('/') && !value.StartsWith("//") && !value.Contains('\\') ? value : ResultsNavigation.ReturnUrl;
    private UserProfileDto? _profile;
    private AchievementAwardDto? _award;
    private bool _mine, _admin, _loading = true, _edit, _avatarEditor, _grant, _busy;
    private string? _error, _editError, _about, _github, _portfolio;
    private readonly CancellationTokenSource _life = new();
    private Guid? _routeUserId;
    private bool _routeInitialized, _routeAdminLayout;
    private int _routeGeneration, _loadVersion;
    protected override async Task OnParametersSetAsync()
    {
        if (_routeInitialized && _routeUserId == UserId && _routeAdminLayout == IsAdminLayout) return;
        _routeInitialized = true; _routeUserId = UserId; _routeAdminLayout = IsAdminLayout; _routeGeneration++;
        _award = null; _grant = _edit = _avatarEditor = _busy = false; _profile = null;
        _about = _github = _portfolio = _editError = null; Dirty.MarkClean();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var version = ++_loadVersion; var userId = UserId;
        _loading = true; _error = null;
        try
        {
            var me = await Me.GetMeAsync(_life.Token);
            var state = await Authentication.GetAuthenticationStateAsync();
            if (version != _loadVersion) return;
            var admin = state.User.IsInRole(Frontend.Shared.Auth.Roles.Admin) || state.User.IsInRole(Frontend.Shared.Auth.Roles.SuperAdmin);
            var mine = userId is null || userId == me.Id;
            var profile = mine ? await Api.MineAsync(_life.Token) : await Api.GetProfileAsync(userId!.Value, _life.Token);
            if (version != _loadVersion || _life.IsCancellationRequested) return;
            _admin = admin; _mine = mine; _profile = profile;
        }
        catch (ApiException ex) { if (version == _loadVersion) _error = ex.Message; }
        catch (OperationCanceledException) when (_life.IsCancellationRequested) { }
        finally { if (version == _loadVersion) _loading = false; }
    }
    private void Edit() { _about = _profile!.AboutMe; _github = _profile.GitHubUrl; _portfolio = _profile.PortfolioUrl; _editError = null; _edit = true; }
    private void CancelEdit() { _edit = false; Dirty.MarkClean(); }
    private async Task SaveProfileAsync()
    {
        var generation = _routeGeneration; _busy = true; _editError = null;
        try { var profile = await Api.SaveProfileAsync(new(_about, _github, _portfolio, Pins()), _life.Token); if (generation != _routeGeneration) return; _profile = profile; _edit = false; Dirty.MarkClean(); Snackbar.Add(ProfileText.T("Профиль сохранён", "Profile saved"), Severity.Success); }
        catch (ApiException ex) { if (generation == _routeGeneration) _editError = ex.Message; }
        finally { if (generation == _routeGeneration) _busy = false; }
    }
    private List<int> Pins() => _profile!.Awards.Where(x => x.PinPosition.HasValue).OrderBy(x => x.PinPosition).Select(x => x.Id).ToList();
    private async Task<bool> SaveAvatarAsync(MediaSelection media)
    {
        var generation = _routeGeneration;
        await Api.SetAvatarAsync(media, _life.Token); var profile = await Api.MineAsync(_life.Token);
        if (generation != _routeGeneration) return true;
        _profile = profile;
        Snackbar.Add(ProfileText.T("Аватар сохранён", "Avatar saved"), Severity.Success); return true;
    }
    private async Task RemoveAvatarAsync()
    {
        var generation = _routeGeneration; _busy = true; _editError = null;
        try { await Api.RemoveAvatarAsync(_life.Token); var profile = await Api.MineAsync(_life.Token); if (generation == _routeGeneration) _profile = profile; }
        catch (ApiException ex) { if (generation == _routeGeneration) _editError = ex.Message; }
        finally { if (generation == _routeGeneration) _busy = false; }
    }
    private async Task TogglePinAsync(AchievementAwardDto award)
    {
        if (!_mine || _profile is null) return;
        var pins = Pins();
        if (!pins.Remove(award.Id)) { if (pins.Count >= 3) { Snackbar.Add(ProfileText.T("Можно закрепить до трёх достижений", "You can pin up to three achievements"), Severity.Warning); return; } pins.Add(award.Id); }
        var generation = _routeGeneration;
        try { var profile = await Api.SaveProfileAsync(new(_profile.AboutMe, _profile.GitHubUrl, _profile.PortfolioUrl, pins), _life.Token); if (generation != _routeGeneration) return; _profile = profile; _award = _profile.Awards.FirstOrDefault(x => x.Id == award.Id); }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
    private async Task RefreshAwardAsync() { _award = null; await LoadAsync(); }
    private async Task GrantDoneAsync() { _grant = false; await LoadAsync(); }
    private static string Date(DateTime value) => value.ToLocalTime().ToString("d", CultureInfo.CurrentCulture);
    public void Dispose() { _life.Cancel(); _life.Dispose(); }
}
