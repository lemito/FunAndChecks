@using Frontend.Shared.Services
@inject IStringLocalizer<AppStrings> Loc
@inject IDialogService DialogService
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-3">@Loc["Login_PrivacyConsentTitle"]</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">@Loc["Login_PrivacyConsentMessage"]</MudText>

        <MudCheckBox @bind-Value="_accepted" Label="@Loc["Login_PrivacyConsentAccept"]" Color="Color.Primary"
                     Required="true" RequiredError="@Loc["Login_PrivacyConsentAcceptRequired"]" Class="mb-4" />

        <MudLink Href="/privacy-policy" Target="_blank" Class="mb-4 d-block">
            @Loc["Login_PrivacyConsentRead"]
        </MudLink>

        <div class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AcceptAsync" Disabled="@(!_accepted || _busy)">
                @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                @Loc["Login_PrivacyConsentAccept"]
            </MudButton>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Action? OnAccepted { get; set; }

    private bool _accepted;
    private bool _busy;

    public void Dispose() { }

    private async Task AcceptAsync()
    {
        if (!_accepted) return;
        _busy = true;
        try
        {
            await Auth.AcceptPrivacyPolicyAsync();
            MudDialog.Close(DialogResult.Ok(true));
            OnAccepted?.Invoke();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    [Inject] private ISnackbar Snackbar { get; set; } = null!;
}